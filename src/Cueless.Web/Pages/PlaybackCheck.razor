@page "/playback-check"
@using Cueless.Application.Playback
@using Cueless.Web.Components

<PageTitle>Cueless — playback check</PageTitle>

<h1>Playback check</h1>

<p>Measures how much audio a snippet actually delivers. Tap play on a cold load, and again after the video is warm.</p>

<ConcealedPlayer @ref="playerComponent" Ready="OnPlayerReady" />

<form class="settings" @onsubmit="RunAsync" @onsubmit:preventDefault>
    <label>
        Video identifier
        <input @bind="videoIdentifier" inputmode="text" autocomplete="off" />
    </label>
    <label>
        Offset (seconds)
        <input type="number" @bind="offsetSeconds" min="0" step="1" />
    </label>
    <label>
        Snippet (seconds)
        <input type="number" @bind="snippetSeconds" min="1" max="10" step="1" />
    </label>
    <button type="submit" disabled="@(!ready || running)">
        @(running ? "Playing…" : "Play snippet")
    </button>
</form>

@if (failure is not null)
{
    <p class="failure">@failure</p>
}

@if (outcomes.Count > 0)
{
    <table>
        <thead>
            <tr><th>Asked</th><th>Heard</th><th>Wall</th><th>Short by</th><th>Stalled</th></tr>
        </thead>
        <tbody>
            @foreach (var outcome in outcomes)
            {
                <tr>
                    <td>@Seconds(outcome.Requested)</td>
                    <td>@Seconds(outcome.Heard)</td>
                    <td>@Seconds(outcome.Elapsed)</td>
                    <td>@Seconds(outcome.Shortfall)</td>
                    <td>@Seconds(outcome.Stalled)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<SnippetOutcome> outcomes = [];

    private ConcealedPlayer? playerComponent;
    private string videoIdentifier = "dQw4w9WgXcQ";
    private int offsetSeconds = 45;
    private int snippetSeconds = 1;
    private bool ready;
    private bool running;
    private string? failure;

    private void OnPlayerReady()
    {
        ready = true;
        StateHasChanged();
    }

    private async Task RunAsync()
    {
        if (playerComponent is null || running)
        {
            return;
        }

        running = true;
        failure = null;

        try
        {
            var snippetPlayer = new SnippetPlayer(playerComponent, TimeProvider.System);

            var outcome = await snippetPlayer.PlayAsync(
                videoIdentifier,
                TimeSpan.FromSeconds(offsetSeconds),
                TimeSpan.FromSeconds(snippetSeconds),
                CancellationToken.None);

            outcomes.Insert(0, outcome);
        }
        catch (SnippetPlaybackException exception)
        {
            failure = exception.Message;
        }
        finally
        {
            running = false;
        }
    }

    private static string Seconds(TimeSpan value) => $"{value.TotalSeconds:0.00}s";
}
