@page "/playback-check"
@using Cueless.Application.Playback
@using Cueless.Web.Components

<PageTitle>Cueless — playback check</PageTitle>

<h1>Playback check</h1>

<p>Cue once, then play repeatedly. Replaying seeks rather than reloading, so a pre-roll should only appear on the first play after a cue.</p>

<ConcealedPlayer @ref="playerComponent" Ready="OnPlayerReady" Concealed="@(!advertising)" />

<form class="settings" @onsubmit="RunAsync" @onsubmit:preventDefault>
    <label>
        Video identifier
        <input @bind="videoIdentifier" inputmode="text" autocomplete="off" />
    </label>
    <label>
        Offset (seconds)
        <input type="number" @bind="offsetSeconds" min="0" step="1" />
    </label>
    <label>
        Snippet (seconds)
        <input type="number" @bind="snippetSeconds" min="1" max="10" step="1" />
    </label>
    <label>
        Pause lead (milliseconds)
        <input type="number" @bind="pauseLeadMilliseconds" min="0" max="1000" step="10" />
    </label>
    <button type="button" disabled="@(!ready || running)" @onclick="PrepareAsync">
        @(prepared ? "Re-cue" : "Cue at offset")
    </button>
    <button type="submit" disabled="@(!prepared || running)">
        @(running ? "Playing…" : "Play snippet")
    </button>
</form>

<p class="status">
    @status
</p>

@if (failure is not null)
{
    <p class="failure">@failure</p>
}

@if (trace.Count > 0)
{
    <details>
        <summary>Trace (@trace.Count samples)</summary>
        <button type="button" class="copy" @onclick="CopyTraceAsync">@copyLabel</button>
        <ol class="trace">
            @foreach (var sample in trace)
            {
                <li>@sample</li>
            }
        </ol>
    </details>
}

@if (outcomes.Count > 0)
{
    <table>
        <thead>
            <tr><th>Asked</th><th>Heard</th><th>Over</th><th>Wall</th><th>Stalled</th></tr>
        </thead>
        <tbody>
            @foreach (var outcome in outcomes)
            {
                <tr>
                    <td>@Seconds(outcome.Requested)</td>
                    <td>@Seconds(outcome.Heard)</td>
                    <td>@Seconds(outcome.Overshoot)</td>
                    <td>@Seconds(outcome.Elapsed)</td>
                    <td>@Seconds(outcome.Stalled)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<SnippetOutcome> outcomes = [];
    private readonly List<string> trace = [];

    private ConcealedPlayer? playerComponent;
    private SnippetProgress? latest;
    private DateTimeOffset lastRender = DateTimeOffset.MinValue;
    private bool prepared;
    private string copyLabel = "Copy trace";
    private string lastShape = string.Empty;
    private DateTimeOffset lastTraced = DateTimeOffset.MinValue;

    private bool advertising => latest?.Advertising ?? false;
    private string videoIdentifier = "dQw4w9WgXcQ";
    private int offsetSeconds = 45;
    private int snippetSeconds = 1;
    private int pauseLeadMilliseconds;

    [Inject]
    private PlaybackSettings Settings { get; set; } = default!;

    [Inject]
    private IApplicationVersion ApplicationVersion { get; set; } = default!;

    [Inject]
    private IJSRuntime JavaScript { get; set; } = default!;
    private bool ready;
    private bool running;
    private string? failure;

    private string status => latest is null
        ? (ready ? "Player ready." : "Loading player…")
        : $"{latest.Phase}{(latest.Advertising ? " · advertisement" : string.Empty)} · {latest.State} · position {Seconds(latest.Position)} · {Seconds(latest.Elapsed)}";

    protected override void OnInitialized() =>
        pauseLeadMilliseconds = (int)Settings.PauseLead.TotalMilliseconds;

    private void OnPlayerReady()
    {
        ready = true;
        StateHasChanged();
    }

    private void Track(SnippetProgress progress)
    {
        latest = progress;

        // Every sample would be hundreds of lines to read, so the trace keeps the
        // moments something changed and a slow heartbeat in between.
        var shape = $"{progress.Phase}|{progress.State}|{progress.Advertising}";
        var now = DateTimeOffset.UtcNow;

        if (shape != lastShape || now - lastTraced >= TimeSpan.FromMilliseconds(500))
        {
            if (trace.Count < 200)
            {
                trace.Add($"{progress.Elapsed.TotalSeconds:0.00} {progress.Phase} {progress.State} pos={progress.Position.TotalSeconds:0.000}{(progress.Advertising ? " AD" : string.Empty)}");
            }

            lastShape = shape;
            lastTraced = now;
        }

        if (now - lastRender < TimeSpan.FromMilliseconds(150))
        {
            return;
        }

        lastRender = now;
        StateHasChanged();
    }

    private async Task PrepareAsync()
    {
        if (playerComponent is null || running)
        {
            return;
        }

        running = true;
        failure = null;
        prepared = false;
        trace.Clear();
        copyLabel = "Copy trace";
        lastShape = string.Empty;
        lastTraced = DateTimeOffset.MinValue;

        try
        {
            await Player().PrepareAsync(
                videoIdentifier,
                TimeSpan.FromSeconds(offsetSeconds),
                new Progress<SnippetProgress>(Track),
                CancellationToken.None);

            prepared = true;
        }
        catch (SnippetPlaybackException exception)
        {
            failure = exception.Message;
        }
        finally
        {
            running = false;
        }
    }

    private SnippetPlayer Player() => new(playerComponent!, TimeProvider.System);

    private async Task CopyTraceAsync()
    {
        var report = string.Join(
            Environment.NewLine,
            [
                $"cueless {ApplicationVersion.Current}",
                $"video={videoIdentifier} offset={offsetSeconds}s snippet={snippetSeconds}s lead={pauseLeadMilliseconds}ms",
                outcomes.Count > 0
                    ? $"asked={Seconds(outcomes[0].Requested)} heard={Seconds(outcomes[0].Heard)} over={Seconds(outcomes[0].Overshoot)} wall={Seconds(outcomes[0].Elapsed)}"
                    : $"no outcome; failure={failure ?? "none"}",
                .. trace,
            ]);

        try
        {
            await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", report);
            copyLabel = "Copied";
        }
        catch (JSException)
        {
            copyLabel = "Copy failed — select the trace by hand";
        }
    }

    private async Task RunAsync()
    {
        if (playerComponent is null || running)
        {
            return;
        }

        running = true;
        failure = null;

        try
        {
            var outcome = await Player().PlayAsync(
                TimeSpan.FromSeconds(offsetSeconds),
                TimeSpan.FromSeconds(snippetSeconds),
                TimeSpan.FromMilliseconds(pauseLeadMilliseconds),
                new Progress<SnippetProgress>(Track),
                CancellationToken.None);

            outcomes.Insert(0, outcome);
        }
        catch (SnippetPlaybackException exception)
        {
            failure = exception.Message;
        }
        finally
        {
            running = false;
        }
    }

    private static string Seconds(TimeSpan value) => $"{value.TotalSeconds:0.00}s";
}
